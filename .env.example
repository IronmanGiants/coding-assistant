# Copy to .env (never commit it) or export these in your shell.
# AWS credentials come from your normal AWS CLI login / profile or the ECS task role.
# Do NOT put access keys in this file or in the code.

AWS_REGION=us-east-1
# Bedrock model, in LiteLLM format
MODEL_ID=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
# Folder the agent's file tools are confined to (local runs)
WORKSPACE=./workspace
